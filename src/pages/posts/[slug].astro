---
import Layout from '@layouts/Layout.astro';
import Markdown from '@components/Markdown.astro';
import { client } from '@utils/sanity-client';

export async function getStaticPaths() {
    const slugs = await client.fetch(`*[_type == "post"]{ "slug": slug.current }`);
    return slugs.map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const post = await client.fetch(
    `*[_type == "post" && slug.current == $slug][0]{
    _id,
    title,
    publishedAt,
    excerpt,
    "author": author->{ name },
    "coverImage": coverImage {
      "src": image.asset->url,
      "alt": alt,
      "dimensions": image.asset->metadata.dimensions
    },
    body,
    metaTitle,
    addTitleSuffix,
    metaDescription,
    "socialImage": socialImage.asset->url
  }`,
    { slug }
);

const fmtDate = (iso?: string) =>
    iso ? new Date(iso).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const coverSrc = post?.coverImage?.src ? `${post.coverImage.src}?w=1600&auto=format` : undefined;
const ogImage = post?.socialImage
    ? { src: post.socialImage }
    : post?.coverImage
      ? { src: post.coverImage.src }
      : undefined;
---

{
    post && (
        <Layout
            title={post.metaTitle ?? post.title}
            addTitleSuffix={post.addTitleSuffix}
            description={post.metaDescription ?? post.excerpt}
            image={ogImage}
        >
            <article class="mx-auto max-w-3xl px-4 py-12">
                {coverSrc && (
                    <img
                        src={coverSrc}
                        alt={post.coverImage?.alt || post.title}
                        width={post.coverImage?.dimensions?.width}
                        height={post.coverImage?.dimensions?.height}
                        class="mb-8 w-full rounded-box object-cover"
                        loading="eager"
                        decoding="async"
                    />
                )}
                <h1 class="text-balance text-3xl font-black sm:text-4xl">{post.title}</h1>
                <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-60">
                    <span>{fmtDate(post.publishedAt)}</span>
                    {post.author?.name && <span>· {post.author.name}</span>}
                </div>
                <div class="mt-8">
                    <Markdown content={post.body ?? ''} />
                </div>
            </article>
        </Layout>
    )
}
