---
import Layout from '@layouts/Layout.astro';
import { client } from '@utils/sanity-client';

const posts = await client.fetch(`*[_type == "post"] | order(publishedAt desc){
  _id,
  title,
  "slug": slug.current,
  publishedAt,
  excerpt,
  "coverImage": coverImage {
    "src": image.asset->url,
    "alt": alt
  }
}`);

const fmtDate = (iso?: string) =>
    iso ? new Date(iso).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<Layout title="文章" description="技术、写作与日常灵感。">
    <div class="mx-auto max-w-5xl px-4 py-16">
        <h1 class="text-3xl font-black sm:text-4xl">文章</h1>
        {
            posts.length === 0 ? (
                <p class="mt-10 opacity-60">还没有文章，去 Sanity Studio 新建一篇 Post 吧。</p>
            ) : (
                <div class="mt-10 grid gap-8 sm:grid-cols-2">
                    {posts.map((post) => (
                        <a
                            href={`/posts/${post.slug}`}
                            class="group block overflow-hidden rounded-box border border-base-200 bg-base-100 transition hover:shadow-lg"
                        >
                            {post.coverImage?.src && (
                                <img
                                    src={`${post.coverImage.src}?w=600&h=400&fit=crop&auto=format`}
                                    alt={post.coverImage.alt || post.title}
                                    class="aspect-[3/2] w-full object-cover"
                                    loading="lazy"
                                    decoding="async"
                                />
                            )}
                            <div class="p-5">
                                <h2 class="text-xl font-bold group-hover:text-primary">{post.title}</h2>
                                <p class="mt-1 text-sm opacity-60">{fmtDate(post.publishedAt)}</p>
                                {post.excerpt && <p class="mt-3 text-sm opacity-80">{post.excerpt}</p>}
                            </div>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</Layout>
